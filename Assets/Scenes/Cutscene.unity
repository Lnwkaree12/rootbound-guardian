  slides:
  - slideSprite: {fileID: 21300000, guid: e58a488857d8eed44972a1be886816bf, type: 3}
    subtitleText: "\u0E01\u0E32\u0E25\u0E04\u0E23\u0E31\u0E49\u0E07\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E19\u0E32\u0E19\u0E21\u0E32\u0E41\u0E25\u0E49\u0E27...
      \u0E13 \u0E43\u0E08\u0E01\u0E25\u0E32\u0E07\u0E1C\u0E37\u0E19\u0E1B\u0E48\u0E32\u0E2D\u0E31\u0E19\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E2A\u0E07\u0E1A
      \u0E21\u0E35 '\u0E15\u0E49\u0E19\u0E44\u0E21\u0E49\u0E42\u0E25\u0E01' \u0E04\u0E2D\u0E22\u0E41\u0E1C\u0E48\u0E01\u0E34\u0E48\u0E07\u0E01\u0E49\u0E32\u0E19\u0E21\u0E2D\u0E1A\u0E1E\u0E25\u0E31\u0E07\u0E2B\u0E25\u0E48\u0E2D\u0E40\u0E25\u0E35\u0E49\u0E22\u0E07\u0E17\u0E38\u0E01\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E43\u0E2B\u0E49\u0E2D\u0E22\u0E39\u0E48\u0E40\u0E22\u0E47\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E38\u0E02"
    readPause: 3.5
    startScale: 1.25
    endScale: 1
    zoomDuration: 7
  - slideSprite: {fileID: 21300000, guid: 3033bb1a08254994982c048a29728855, type: 3}
    subtitleText: "\u0E17\u0E27\u0E48\u0E32\u0E27\u0E31\u0E19\u0E40\u0E27\u0E25\u0E32\u0E1C\u0E31\u0E19\u0E1C\u0E48\u0E32\u0E19...
      \u0E1E\u0E25\u0E31\u0E07\u0E41\u0E2B\u0E48\u0E07\u0E1E\u0E24\u0E01\u0E29\u0E32\u0E40\u0E23\u0E34\u0E48\u0E21\u0E23\u0E48\u0E27\u0E07\u0E42\u0E23\u0E22
      \u0E15\u0E49\u0E19\u0E44\u0E21\u0E49\u0E28\u0E31\u0E01\u0E14\u0E34\u0E4C\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E4C\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E2B\u0E35\u0E48\u0E22\u0E27\u0E40\u0E09\u0E32
      \u0E1C\u0E37\u0E19\u0E1B\u0E48\u0E32\u0E17\u0E35\u0E48\u0E40\u0E04\u0E22\u0E40\u0E02\u0E35\u0E22\u0E27\u0E0A\u0E2D\u0E38\u0E48\u0E21\u0E01\u0E47\u0E04\u0E48\u0E2D\u0E22\u0E46
      \u0E41\u0E2B\u0E49\u0E07\u0E41\u0E25\u0E49\u0E07\u0E25\u0E07"
    readPause: 3.5
    startScale: 1.25
    endScale: 1
    zoomDuration: 7
  - slideSprite: {fileID: 21300000, guid: 4f6b5126be6bdc7449fc6098fe80239d, type: 3}
    subtitleText: "\u0E41\u0E21\u0E49\u0E43\u0E1A\u0E44\u0E21\u0E49\u0E2A\u0E35\u0E40\u0E02\u0E35\u0E22\u0E27\u0E08\u0E30\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E35\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E07\u0E17\u0E2D\u0E07\u0E23\u0E48\u0E27\u0E07\u0E2B\u0E25\u0E48\u0E19
