  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LumiCompanion
  target: {fileID: 0}
  followOffset: {x: -0.75, y: 1.35, z: -0.4}
  smoothTime: 0.28
  maxSpeed: 16
  maxDistanceBeforeTeleport: 25
  hoverFrequency: 2.2
  hoverAmplitude: 0.12
  rotationSpeed: 6
  bankAmount: 15
  idleFacingAngleY: 155.4
  useFixedIdleAngle: 1
  animator: {fileID: 8926367872692245932}
  idleAnimSpeed: 1
  fastAnimSpeed: 1.8
  dialogueCanvas: {fileID: 484594203680755040}
  bubbleTransform: {fileID: 1474176431776188430}
  bubbleCanvasGroup: {fileID: 2011840324554656691}
  dialogueText: {fileID: 2163205095776807545}
  minDialogueInterval: 10
  maxDialogueInterval: 20
  bubbleDisplayDuration: 4
  auraLight: {fileID: 2421072700094485464}
  baseLightIntensity: 1.5
  lightPulseAmplitude: 0.3
  lightPulseFrequency: 2
  banterLines:
  - "\u0E40\u0E14\u0E34\u0E19\u0E23\u0E30\u0E27\u0E31\u0E07\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E2A\u0E34\u0E40\u0E08\u0E49\u0E32\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C!
    \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E01\u0E47\u0E2A\u0E30\u0E14\u0E38\u0E14\u0E2B\u0E34\u0E19\u0E2B\u0E23\u0E2D\u0E01
    \u0E2E\u0E34\u0E46~"
  - "\u0E27\u0E49\u0E32\u0E27 \u0E25\u0E32\u0E27\u0E32\u0E15\u0E23\u0E07\u0E19\u0E31\u0E49\u0E19\u0E2A\u0E35\u0E2A\u0E27\u0E22\u0E08\u0E31\u0E07...
    \u0E41\u0E15\u0E48\u0E2D\u0E22\u0E48\u0E32\u0E01\u0E23\u0E30\u0E42\u0E14\u0E14\u0E25\u0E07\u0E44\u0E1B\u0E40\u0E25\u0E48\u0E19\u0E19\u0E30!"
  - "\u0E1B\u0E35\u0E01\u0E02\u0E49\u0E32\u0E2A\u0E27\u0E22\u0E21\u0E31\u0E49\u0E22\u0E25\u0E48\u0E30?
    \u0E1A\u0E34\u0E19\u0E17\u0E31\u0E49\u0E07\u0E27\u0E31\u0E19\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E40\u0E2B\u0E19\u0E37\u0E48\u0E2D\u0E22\u0E40\u0E25\u0E22\u0E19\u0E30\u0E08\u0E30\u0E1A\u0E2D\u0E01\u0E43\u0E2B\u0E49~"
  - "\u0E19\u0E35\u0E48\u0E46 \u0E40\u0E14\u0E34\u0E19\u0E40\u0E23\u0E47\u0E27\u0E46
    \u0E2B\u0E19\u0E48\u0E2D\u0E22 \u0E02\u0E49\u0E32\u0E1A\u0E34\u0E19\u0E19\u0E33\u0E44\u0E1B\u0E44\u0E01\u0E25\u0E41\u0E25\u0E49\u0E27\u0E19\u0E30!"
  - "\u0E41\u0E16\u0E27\u0E19\u0E35\u0E49\u0E21\u0E37\u0E14\u0E08\u0E31\u0E07 \u0E14\u0E35\u0E19\u0E30\u0E17\u0E35\u0E48\u0E21\u0E35\u0E02\u0E49\u0E32\u0E04\u0E2D\u0E22\u0E2A\u0E48\u0E2D\u0E07\u0E44\u0E1F\u0E43\u0E2B\u0E49\u0E2D\u0E48\u0E30!"
  - "\u0E2E\u0E31\u0E48\u0E19\u0E41\u0E19\u0E48! \u0E41\u0E2D\u0E1A\u0E21\u0E2D\u0E07\u0E02\u0E49\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E25\u0E48\u0E30\u0E2A\u0E34
    \u0E21\u0E35\u0E02\u0E49\u0E32\u0E44\u0E1B\u0E14\u0E49\u0E27\u0E22\u0E2D\u0E38\u0E48\u0E19\u0E43\u0E08\u0E43\u0E0A\u0E48\u0E21\u0E49\u0E32~"
  - "\u0E2A\u0E39\u0E49\u0E40\u0E02\u0E32\u0E19\u0E30\u0E40\u0E08\u0E49\u0E32\u0E2A\u0E2D\u0E07\u0E02\u0E32
    \u0E02\u0E49\u0E32\u0E40\u0E2D\u0E32\u0E43\u0E08\u0E0A\u0E48\u0E27\u0E22\u0E2D\u0E22\u0E39\u0E48\u0E02\u0E49\u0E32\u0E07\u0E46
    \u0E19\u0E35\u0E48\u0E41\u0E2B\u0E25\u0E30!"
  - "\u0E40\u0E2B\u0E19\u0E37\u0E48\u0E2D\u0E22\u0E23\u0E36\u0E22\u0E31\u0E07? \u0E02\u0E49\u0E32\u0E25\u0E2D\u0E22\u0E15\u0E31\u0E27\u0E2A\u0E1A\u0E32\u0E22\u0E08\u0E31\u0E07
    \u0E44\u0E21\u0E48\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E22\u0E02\u0E32\u0E40\u0E25\u0E22\u0E2A\u0E31\u0E01\u0E19\u0E34\u0E14
    \u0E2D\u0E34\u0E2D\u0E34"
  - "\u0E23\u0E30\u0E27\u0E31\u0E07\u0E2B\u0E31\u0E27\u0E14\u0E49\u0E27\u0E22\u0E19\u0E30\u0E02\u0E49\u0E32\u0E07\u0E2B\u0E19\u0E49\u0E32
    \u0E02\u0E49\u0E32\u0E15\u0E31\u0E27\u0E40\u0E25\u0E47\u0E01\u0E02\u0E49\u0E32\u0E2B\u0E25\u0E1A\u0E07\u0E48\u0E32\u0E22
    \u0E41\u0E15\u0E48\u0E40\u0E08\u0E49\u0E32\u0E15\u0E31\u0E27\u0E42\u0E15\u0E19\u0E30!"
  - "\u0E02\u0E49\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E27\u0E34\u0E0D\u0E0D\u0E32\u0E13\u0E41\u0E2B\u0E48\u0E07\u0E41\u0E2A\u0E07\u0E17\u0E35\u0E48\u0E19\u0E48\u0E32\u0E23\u0E31\u0E01\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14\u0E43\u0E19\u0E1B\u0E48\u0E32\u0E41\u0E25\u0E49\u0E27
    \u0E22\u0E2D\u0E21\u0E23\u0E31\u0E1A\u0E21\u0E32\u0E0B\u0E30\u0E14\u0E35\u0E46!"
