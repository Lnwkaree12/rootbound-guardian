--- !u!114 &2055473354489993755
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6260077195351638259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 293ba693c8eb11f4bb3e41395febec76, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCinematicManager
  slides:
  - sprite: {fileID: 21300000, guid: e658df331f4cf9744b9c98bda17ccadb, type: 3}
    narrativeText: "\u0E17\u0E48\u0E32\u0E21\u0E01\u0E25\u0E32\u0E07\u0E04\u0E48\u0E33\u0E04\u0E37\u0E19\u0E2D\u0E31\u0E19\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E2A\u0E07\u0E31\u0E14...
      \u0E40\u0E14\u0E47\u0E01\u0E2A\u0E32\u0E27\u0E40\u0E2D\u0E25\u0E1F\u0E4C\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E1C\u0E39\u0E49\u0E1E\u0E34\u0E17\u0E31\u0E01\u0E29\u0E4C\u0E1B\u0E48\u0E32\u0E44\u0E14\u0E49\u0E19\u0E31\u0E48\u0E07\u0E04\u0E38\u0E01\u0E40\u0E02\u0E48\u0E32\u0E27\u0E34\u0E07\u0E27\u0E2D\u0E19\u0E2D\u0E18\u0E34\u0E29\u0E10\u0E32\u0E19\u0E15\u0E48\u0E2D\u0E14\u0E27\u0E07\u0E14\u0E32\u0E27\u0E1A\u0E19\u0E1F\u0E32\u0E01\u0E1F\u0E49\u0E32
      \u0E2B\u0E27\u0E31\u0E07\u0E43\u0E2B\u0E49\u0E21\u0E35\u0E1B\u0E32\u0E0F\u0E34\u0E2B\u0E32\u0E23\u0E34\u0E22\u0E4C\u0E40\u0E01\u0E34\u0E14\u0E02\u0E36\u0E49\u0E19\u0E01\u0E31\u0E1A\u0E42\u0E25\u0E01\u0E43\u0E1A\u0E19\u0E35\u0E49\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E01\u0E31\u0E1A\u0E04\u0E27\u0E32\u0E21\u0E0A\u0E31\u0E48\u0E27\u0E23\u0E49\u0E32\u0E22..."
  - sprite: {fileID: 21300000, guid: 06c4bbc202ea76d4e9167def92a674c3, type: 3}
    narrativeText: "\u0E17\u0E31\u0E19\u0E43\u0E14\u0E19\u0E31\u0E49\u0E19! \u0E25\u0E33\u0E41\u0E2A\u0E07\u0E40\u0E08\u0E34\u0E14\u0E08\u0E23\u0E31\u0E2A\u0E1E\u0E38\u0E48\u0E07\u0E27\u0E32\u0E1A\u0E1C\u0E48\u0E32\u0E19\u0E2B\u0E21\u0E39\u0E48\u0E40\u0E21\u0E06
      \u0E14\u0E32\u0E27\u0E15\u0E01\u0E2A\u0E35\u0E17\u0E2D\u0E07\u0E14\u0E27\u0E07\u0E43\u0E2B\u0E0D\u0E48\u0E15\u0E01\u0E25\u0E07\u0E21\u0E32\u0E22\u0E31\u0E07\u0E40\u0E1A\u0E37\u0E49\u0E2D\u0E07\u0E2B\u0E19\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E23\u0E27\u0E14\u0E40\u0E23\u0E47\u0E27
      \u0E40\u0E01\u0E34\u0E14\u0E41\u0E23\u0E07\u0E2A\u0E31\u0E48\u0E19\u0E2A\u0E30\u0E40\u0E17\u0E37\u0E2D\u0E19\u0E41\u0E25\u0E30\u0E25\u0E30\u0E2D\u0E2D\u0E07\u0E40\u0E27\u0E17\u0E21\u0E19\u0E15\u0E23\u0E4C\u0E01\u0E23\u0E30\u0E08\u0E32\u0E22\u0E44\u0E1B\u0E17\u0E31\u0E48\u0E27\u0E17\u0E38\u0E48\u0E07\u0E2B\u0E0D\u0E49\u0E32..."
  - sprite: {fileID: 21300000, guid: 7cdc04ac569282148aecd921e42dba27, type: 3}
    narrativeText: "\u0E41\u0E15\u0E48\u0E17\u0E27\u0E48\u0E32... \u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E1B\u0E23\u0E32\u0E01\u0E0F\u0E15\u0E48\u0E2D\u0E2B\u0E19\u0E49\u0E32\u0E40\u0E18\u0E2D\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E01\u0E49\u0E2D\u0E19\u0E2D\u0E38\u0E01\u0E01\u0E32\u0E1A\u0E32\u0E15\u0E18\u0E23\u0E23\u0E21\u0E14\u0E32
      \u0E41\u0E15\u0E48\u0E40\u0E1B\u0E47\u0E19 '\u0E20\u0E39\u0E15\u0E41\u0E2B\u0E48\u0E07\u0E41\u0E2A\u0E07'
      \u0E25\u0E2D\u0E22\u0E15\u0E31\u0E27\u0E2A\u0E48\u0E07\u0E22\u0E34\u0E49\u0E21\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E2D\u0E48\u0E2D\u0E19\u0E42\u0E22\u0E19
      \u0E41\u0E17\u0E49\u0E08\u0E23\u0E34\u0E07\u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E19\u0E04\u0E37\u0E2D\u0E1C\u0E39\u0E49\u0E1E\u0E34\u0E17\u0E31\u0E01\u0E29\u0E4C\u0E17\u0E35\u0E48\u0E15\u0E01\u0E25\u0E07\u0E21\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E0A\u0E48\u0E27\u0E22\u0E1B\u0E01\u0E1B\u0E49\u0E2D\u0E07\u0E42\u0E25\u0E01\u0E08\u0E32\u0E01\u0E40\u0E2B\u0E25\u0E48\u0E32\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C!"
  - sprite: {fileID: 21300000, guid: 2fa2e255e318bdf4da2bf76ca9108e1e, type: 3}
    narrativeText: "\u0E20\u0E39\u0E15\u0E41\u0E2B\u0E48\u0E07\u0E41\u0E2A\u0E07\u0E44\u0E14\u0E49\u0E22\u0E37\u0E48\u0E19\u0E40\u0E02\u0E47\u0E21\u0E17\u0E34\u0E28\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E43\u0E2B\u0E49
      \u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E21\u0E2D\u0E1A\u0E20\u0E32\u0E23\u0E01\u0E34\u0E08\u0E2A\u0E33\u0E04\u0E31\u0E0D...
      '\u0E08\u0E07\u0E40\u0E14\u0E34\u0E19\u0E17\u0E32\u0E07\u0E40\u0E02\u0E49\u0E32\u0E2A\u0E39\u0E48\u0E14\u0E31\u0E19\u0E40\u0E08\u0E35\u0E49\u0E22\u0E19\u0E2B\u0E34\u0E19\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E41\u0E2B\u0E48\u0E07\u0E19\u0E31\u0E49\u0E19
      \u0E41\u0E25\u0E30\u0E15\u0E32\u0E21\u0E2B\u0E32\u0E01\u0E38\u0E0D\u0E41\u0E08\u0E40\u0E27\u0E17\u0E21\u0E19\u0E15\u0E23\u0E4C\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E02\u0E31\u0E1A\u0E44\u0E25\u0E48\u0E04\u0E27\u0E32\u0E21\u0E21\u0E37\u0E14\u0E21\u0E34\u0E14!'
      \u0E01\u0E32\u0E23\u0E1C\u0E08\u0E0D\u0E20\u0E31\u0E22\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E44\u0E14\u0E49\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E02\u0E36\u0E49\u0E19\u0E41\u0E25\u0E49\u0E27..."
